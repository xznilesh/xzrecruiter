# XZ Recruiter only. Publishable Supabase values are safe for client/server requests.
NEXT_PUBLIC_SUPABASE_URL=https://fpfwvvjxodcchgyguvpv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_CURRENT_KEY

# Server-only secret used for private recruitment document storage. Never expose as NEXT_PUBLIC_*.
# Configure manually in Vercel only when Step 4 production activation is approved.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SECURE_RUNTIME_ONLY
XZRECRUITER_STORAGE_BUCKET=xzrecruiter-private

# Optional restricted direct database connection retained for operational tooling.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SESSION_COOKIE_SECURE=true
